<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded" android:orientation="vertical" android:padding="20dp">
    <TextView android:id="@+id/tvDlgTitle" style="@style/SariLabel" android:text="New Sale" android:textSize="17sp"/>
    <EditText android:id="@+id/etItem" style="@style/SariField" android:hint="Item" android:inputType="text"/>
    <EditText android:id="@+id/etQty" style="@style/SariField" android:hint="Quantity" android:inputType="number"/>
    <EditText android:id="@+id/etPrice" style="@style/SariField" android:hint="Price per unit (₱)" android:inputType="numberDecimal"/>
    <TextView android:id="@+id/tvTotal" style="@style/SariLabel" android:layout_marginTop="12dp" android:text="Total: ₱0.00" android:textColor="@color/red_dark"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:orientation="horizontal" android:weightSum="2">
        <TextView android:id="@+id/btnCancel" style="@style/SariPill" android:layout_width="0dp" android:layout_weight="1"
            android:layout_marginRight="6dp" android:gravity="center" android:padding="12dp" android:text="Cancel"/>
        <TextView android:id="@+id/btnSave" style="@style/SariButton" android:layout_width="0dp" android:layout_weight="1"
            android:layout_marginLeft="6dp" android:text="Save"/>
    </LinearLayout>
</LinearLayout>
