<?xml version="1.0" encoding="utf-8"?>
<!-- Homepage Layout for sariManang app displaying daily sales summary, quick action buttons, overdue utang, low stock alerts, and sales estimates -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fitsSystemWindows="true" android:orientation="vertical">

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <!-- Section 1: Header with App Logo, User Greeting, and Current Date -->
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
                <ImageView android:id="@+id/ivLogo" android:layout_width="140dp" android:layout_height="48dp"
                    android:adjustViewBounds="true" android:src="@drawable/logo"/>
                <TextView android:id="@+id/tvHello" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_alignParentRight="true" android:layout_centerVertical="true"
                    android:text="Hello, Store Owner" android:textColor="@color/red_dark" android:textStyle="bold"/>
                <TextView android:id="@+id/tvDate" style="@style/SariMuted" android:layout_below="@id/ivLogo"
                    android:layout_marginTop="6dp" android:textColor="@color/text_dark" android:textSize="13sp"/>
            </RelativeLayout>

            <!-- Section 2: Quick Action Buttons (New Sale, Record Utang, Add Stock) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:orientation="horizontal" android:padding="4dp">
                <TextView android:id="@+id/btnNewSale" style="@style/SariPill" android:layout_marginRight="10dp" android:text="+ New Sale"/>
                <TextView android:id="@+id/btnRecordUtang" style="@style/SariPill" android:layout_marginRight="10dp" android:text="+ Record Utang"/>
                <TextView android:id="@+id/btnAddStock" style="@style/SariPill" android:text="+ Add Stock"/>
            </LinearLayout>

            <!-- Section 3: Today's Total Sales Summary Card -->
            <LinearLayout style="@style/SariCard" android:layout_marginTop="12dp">
                <TextView style="@style/SariLabel" android:text="Today's Total Sales"/>
                <TextView android:id="@+id/tvTodaySales" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="₱ 0.00" android:textColor="@color/text_dark"
                    android:textSize="28sp"/>
                <TextView android:id="@+id/tvTodayTransactions" style="@style/SariMuted" android:text="0 transactions today"/>
            </LinearLayout>

            <!-- Section 4: Overdue Utang and Low Stock Alerts Card -->
            <LinearLayout style="@style/SariCard">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView style="@style/SariLabel" android:text="Overdue Utang"/>
                    <TextView android:id="@+id/tvHomeUtangSummary" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_alignParentRight="true" android:text=""
                        android:textColor="@color/red_dark" android:textSize="12sp" android:textStyle="bold"/>
                </RelativeLayout>
                <LinearLayout android:id="@+id/listOverdueUtang" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical"/>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:background="#DDDDDD"/>
                <TextView style="@style/SariLabel" android:layout_marginTop="10dp" android:text="Low Stock"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_circle"
                        android:gravity="center" android:text="S" android:textColor="#FFFFFF" android:textStyle="bold"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="10dp"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/SariLabel" android:text="Selecta Ice Cream" android:textSize="13sp"/>
                        <TextView style="@style/SariMuted" android:text="PureGold  ★ 4.8"/>
                    </LinearLayout>
                    <TextView style="@style/SariMuted" android:text="2 left" android:textColor="@color/red_dark" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingLeft="6dp" android:paddingRight="6dp" android:weightSum="2">
                <LinearLayout style="@style/SariCard" android:layout_width="0dp" android:layout_weight="1" android:gravity="center_horizontal">
                    <TextView style="@style/SariLabel" android:text="Best-Selling"/>
                    <TextView android:id="@+id/tvHomeBest" style="@style/SariMuted" android:layout_marginTop="6dp" android:gravity="center" android:textColor="@color/green"/>
                </LinearLayout>
                <LinearLayout style="@style/SariCard" android:layout_width="0dp" android:layout_weight="1" android:gravity="center_horizontal">
                    <TextView style="@style/SariLabel" android:text="Least-Selling"/>
                    <TextView android:id="@+id/tvHomeLeast" style="@style/SariMuted" android:layout_marginTop="6dp" android:gravity="center" android:textColor="@color/red_dark"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Section 5: Sales Estimate and Progress Tracker -->
            <LinearLayout style="@style/SariCard">
                <TextView style="@style/SariLabel" android:text="Sales Estimate"/>
                <TextView android:id="@+id/tvHomeEstimate" style="@style/SariMuted" android:layout_marginTop="6dp"
                    android:text="Log at least 5 sales to unlock estimates."/>
                <ProgressBar android:id="@+id/pbHomeEstimate" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="8dp"
                    android:max="5" android:progress="0" android:progressTint="@color/red"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <include layout="@layout/bottomnavigation"/>
</LinearLayout>