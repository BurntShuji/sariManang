<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fitsSystemWindows="true" android:orientation="vertical">
    <include layout="@layout/toolbar"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">
                <TextView android:id="@+id/btnLogSale" style="@style/SariPill" android:layout_marginRight="10dp" android:text="+ Log Sale"/>
                <TextView android:id="@+id/btnRecordUtang" style="@style/SariPill" android:text="+ Record Utang"/>
            </LinearLayout>
            <LinearLayout style="@style/SariCard">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView style="@style/SariLabel" android:text="History"/>
                    <TextView android:id="@+id/tvViewFull" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_alignParentRight="true" android:text="View Full History"
                        android:textColor="@color/red_dark" android:textSize="12sp"/>
                </RelativeLayout>
                <LinearLayout android:id="@+id/listHistory" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"/>
            </LinearLayout>
            <LinearLayout style="@style/SariCard">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView style="@style/SariLabel" android:text="Utang Records"/>
                    <TextView android:id="@+id/tvUtangSummary" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_alignParentRight="true" android:text="Total: ₱0.00"
                        android:textColor="@color/red_dark" android:textSize="12sp" android:textStyle="bold"/>
                </RelativeLayout>
                <LinearLayout android:id="@+id/listUtangSales" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical"/>
            </LinearLayout>
            <LinearLayout style="@style/SariCard">
                <TextView style="@style/SariLabel" android:text="Sales Estimate"/>
                <TextView android:id="@+id/tvEstimate" style="@style/SariMuted" android:layout_marginTop="6dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingLeft="6dp" android:paddingRight="6dp" android:weightSum="2">
                <LinearLayout style="@style/SariCard" android:layout_width="0dp" android:layout_weight="1" android:gravity="center_horizontal">
                    <TextView style="@style/SariLabel" android:text="Best-Selling"/>
                    <TextView android:id="@+id/tvBest" style="@style/SariMuted" android:layout_marginTop="6dp" android:gravity="center" android:textColor="@color/green"/>
                </LinearLayout>
                <LinearLayout style="@style/SariCard" android:layout_width="0dp" android:layout_weight="1" android:gravity="center_horizontal">
                    <TextView style="@style/SariLabel" android:text="Least-Selling"/>
                    <TextView android:id="@+id/tvLeast" style="@style/SariMuted" android:layout_marginTop="6dp" android:gravity="center" android:textColor="@color/red_dark"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/bottomnavigation"/>
</LinearLayout>
