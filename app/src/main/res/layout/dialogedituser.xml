<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded" android:orientation="vertical" android:padding="20dp">
    <TextView android:id="@+id/tvDlgTitle" style="@style/SariLabel" android:text="Edit User" android:textSize="17sp"/>
    <TextView android:id="@+id/tvUserId" style="@style/SariMuted" android:layout_marginTop="2dp"/>
    <EditText android:id="@+id/etName" style="@style/SariField" android:hint="Full name" android:inputType="textPersonName"/>
    <EditText android:id="@+id/etEmail" style="@style/SariField" android:hint="Email" android:inputType="textEmailAddress"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:orientation="horizontal" android:weightSum="2">
        <TextView android:id="@+id/btnCancel" style="@style/SariPill" android:layout_width="0dp" android:layout_weight="1"
            android:layout_marginRight="6dp" android:gravity="center" android:padding="12dp" android:text="Cancel"/>
        <TextView android:id="@+id/btnSave" style="@style/SariButton" android:layout_width="0dp" android:layout_weight="1"
            android:layout_marginLeft="6dp" android:text="Save"/>
    </LinearLayout>
</LinearLayout>
