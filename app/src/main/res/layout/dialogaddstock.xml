<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded" android:orientation="vertical" android:padding="20dp">
    <TextView android:id="@+id/tvDlgTitle" style="@style/SariLabel" android:text="Add Stock" android:textSize="17sp"/>
    <AutoCompleteTextView android:id="@+id/etItem" style="@style/SariField" android:hint="Item name" android:inputType="text" android:completionThreshold="1"/>
    <EditText android:id="@+id/etQty" style="@style/SariField" android:hint="Current stock" android:inputType="number"/>
    <EditText android:id="@+id/etPrice" style="@style/SariField" android:hint="Price (₱)" android:inputType="numberDecimal"/>
    <EditText android:id="@+id/etExpiry" style="@style/SariField" android:hint="Expiration date" android:inputType="text"/>
    <EditText android:id="@+id/etBatch" style="@style/SariField" android:hint="Batch number" android:inputType="text"/>
    <EditText android:id="@+id/etAlert" style="@style/SariField" android:hint="Alert me when stock drops to" android:inputType="number"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:orientation="horizontal" android:weightSum="2">
        <TextView android:id="@+id/btnCancel" style="@style/SariPill" android:layout_width="0dp" android:layout_weight="1"
            android:layout_marginRight="6dp" android:gravity="center" android:padding="12dp" android:text="Cancel"/>
        <TextView android:id="@+id/btnSave" style="@style/SariButton" android:layout_width="0dp" android:layout_weight="1"
            android:layout_marginLeft="6dp" android:text="Save"/>
    </LinearLayout>
</LinearLayout>
